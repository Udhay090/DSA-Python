class Solution:
    def solve(self, board: List[List[str]]) -> None:
        rows = len(board)
        cols = len(board[0])

        global_visited = set()

        def dfs(r, c, region):
            if (
                r < 0 or r >= rows or
                c < 0 or c >= cols or
                board[r][c] == "X" or
                (r, c) in region
            ):
                return

            region.add((r, c))

            dfs(r + 1, c, region)
            dfs(r - 1, c, region)
            dfs(r, c + 1, region)
            dfs(r, c - 1, region)

        for r in range(rows):
            for c in range(cols):

                if board[r][c] == "O" and (r, c) not in global_visited:

                    region = set()
                    dfs(r, c, region)

                    global_visited.update(region)

                    touches_border = False

                    for i, j in region:
                        if (
                            i == 0 or i == rows - 1 or
                            j == 0 or j == cols - 1
                        ):
                            touches_border = True
                            break

                    if not touches_border:
                        for i, j in region:
                            board[i][j] = "X"
