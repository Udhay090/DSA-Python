class Solution:
    def maxAreaOfIsland(self, grid: List[List[int]]) -> int:
        rows = len(grid)
        cols = len(grid[0])

        def dfs(r, c, visited):
            if (
                r < 0 or r >= rows or
                c < 0 or c >= cols or
                grid[r][c] == 0 or
                (r, c) in visited
            ):
                return 0

            visited.add((r, c))

            area = 1

            area += dfs(r + 1, c, visited)
            area += dfs(r - 1, c, visited)
            area += dfs(r, c + 1, visited)
            area += dfs(r, c - 1, visited)

            return area

        max_area = 0

        for r in range(rows):
            for c in range(cols):
                if grid[r][c] == 1:
                    visited = set()
                    area = dfs(r, c, visited)
                    max_area = max(max_area, area)

        return max_area
